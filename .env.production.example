# ============================================================================
# TEMPLATE .env UNTUK PRODUKSI -- Portfolio DKV SMEKDA
#
# Salin menjadi .env DI SERVER (jangan di-commit), lalu ganti semua nilai
# bertanda GANTI. Panduan lengkap: docs/DEPLOYMENT.md
# ============================================================================

APP_NAME="Portfolio DKV SMEKDA"
APP_ENV=production
# Isi dengan: php artisan key:generate --show   (jangan pakai ulang key dev)
APP_KEY=
# WAJIB false di produksi: debug true membocorkan path, query, dan isi .env
# lewat halaman error.
APP_DEBUG=false
# GANTI: alamat HTTPS publik. Dipakai untuk tautan reset password & QR.
APP_URL=https://GANTI-domain-sekolah.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# Zona waktu aplikasi (WIB). Dipakai untuk created_at/updated_at & tampilan tanggal.
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# error (bukan debug) supaya log tidak penuh data permintaan.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# GANTI: jangan pakai user root. Buat user MySQL khusus aplikasi.
DB_DATABASE=GANTI_nama_database
DB_USERNAME=GANTI_user_db
DB_PASSWORD=GANTI_password_kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true jika situs diakses lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------------------------------------------------------------------------
# EMAIL -- wajib diisi agar fitur "Lupa Password" benar-benar mengirim email.
# MAIL_MAILER=log / array berarti email TIDAK PERNAH terkirim.
# Contoh di bawah memakai SMTP umum (mis. Gmail dengan App Password, atau
# SMTP hosting sekolah). Sesuaikan dengan penyedia yang dipakai.
# ---------------------------------------------------------------------------
# Port 587 (STARTTLS): biarkan MAIL_SCHEME=null. Port 465 (SSL): MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=GANTI_smtp.penyedia.com
MAIL_PORT=587
MAIL_USERNAME=GANTI_username_smtp
MAIL_PASSWORD=GANTI_password_smtp
MAIL_FROM_ADDRESS="GANTI-noreply@domain-sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
